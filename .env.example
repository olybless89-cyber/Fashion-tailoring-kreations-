# Railway: reference the Postgres service variable -> ${{Postgres.DATABASE_URL}}
DATABASE_URL="postgresql://user:password@host:5432/railway"

# Public site URL (used for Paystack callback, sitemap, OG tags)
NEXT_PUBLIC_SITE_URL="https://ftk.up.railway.app"

# Admin login for /admin
ADMIN_EMAIL="admin@fashiontailoringkreations.com"
ADMIN_PASSWORD="change-me-to-something-long"
# Long random string: openssl rand -base64 48
AUTH_SECRET="replace-with-a-long-random-string"

# Paystack (leave blank to accept bank transfer only)
PAYSTACK_SECRET_KEY=""
NEXT_PUBLIC_PAYSTACK_ENABLED="false"

# Business details shown on the site
NEXT_PUBLIC_WHATSAPP="2348000000000"
NEXT_PUBLIC_PHONE="+234 800 000 0000"
NEXT_PUBLIC_EMAIL="orders@fashiontailoringkreations.com"
NEXT_PUBLIC_INSTAGRAM=""
NEXT_PUBLIC_ADDRESS="Abuja, Nigeria"

# Bank transfer details shown after checkout
BANK_NAME="Your Bank"
BANK_ACCOUNT_NAME="Fashion Tailoring Kreation"
BANK_ACCOUNT_NUMBER="0000000000"

# Delivery fees in Naira
DELIVERY_FEE="5000"
FREE_DELIVERY_OVER="300000"
